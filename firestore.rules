rules_version = '2';

// Each signed-in user can only read and write documents under users/{their uid}/,
// in the collections the app uses. Paste this in the Firebase console:
// Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{collection}/{docId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && collection in ['acts', 'entries', 'notes', 'skills', 'rounds', 'recordings']
        && request.resource.data.t is number
        && request.resource.data.st == request.time;
    }
  }
}
